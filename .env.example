AI_PORT=8790
WORKFLOW_CANVAS_PORT=5174
RENDER_PORT=8787

# 页面和接口的公网基址，部署到服务器后请改成你的域名或公网 IP
PUBLIC_AI_BASE_URL=http://your-server-ip:8790
PUBLIC_RENDER_BASE_URL=http://your-server-ip:8787
WORKFLOW_CANVAS_ROOT=public

MIMO_API_KEY=your_mimo_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_VIDEO_MODEL=mimo-v2.5

MINIMAX_API_KEY=your_minimax_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-hd

GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_API_KEY=your_grsai_or_openai_key

MAX_VIDEO_DOWNLOAD_BYTES=52428800
