AI_PORT=8790
WORKFLOW_CANVAS_PORT=5174
RENDER_PORT=8787

# 页面和接口的公网基址，部署到服务器后请改成你的域名或公网 IP
PUBLIC_AI_BASE_URL=http://your-server-ip:8790
PUBLIC_RENDER_BASE_URL=http://your-server-ip:8787
WORKFLOW_CANVAS_ROOT=public

# ── 知识库桶（私有）。storage:server 用它做两件事：
#    1. 浏览/上传知识库对象
#    2. 拼 MetaInsight 的 ci 域名（appId 从桶名尾段取，region 直接用 COS_REGION）
#    所以它必须指向放着多模态检索数据集的那个桶，region 也必须跟数据集同地域。
#    指错了图片/视频/文档检索会静默查不到东西。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
STORAGE_PORT=8791

# ── 前端资产桶（公开读）。只有 cos:sync 用，跟上面那个桶是两回事：
#    这个桶放要给公网展示的图片视频，知识库内部资料不进这里。
#    留空则回落到 COS_BUCKET/COS_REGION（单桶部署时可以这样）。
ASSET_BUCKET=
ASSET_REGION=
# 上传时的对象前缀，默认 assets
COS_ASSET_PREFIX=assets
# 绑定了 CDN 加速域名就填这里，留空则回落到资产桶的源站域名
COS_CDN_BASE=

# 前端读图读视频的基址。留空时回落到 /assets（本地 public 目录）。
# 素材上传到 COS 后填 cos:sync 打印出来的那个地址，媒体文件就不再进构建产物。
VITE_ASSET_BASE=

# 腾讯云智能体开发平台 ADP（LKE）
ADP_SECRET_ID=
ADP_SECRET_KEY=
ADP_REGION=ap-guangzhou
ADP_APP_BIZ_ID=
ADP_BOT_BIZ_ID=
ADP_APP_KEY=
METAINSIGHT_CONNECTOR_TOKEN=
METAINSIGHT_MCP_TOKEN=
METAINSIGHT_MCP_PORT=8792
METAINSIGHT_IMAGE_DATASET=717-image-search
METAINSIGHT_VIDEO_DATASET=717-video-search
METAINSIGHT_DOC_DATASET=717-doc-search

MIMO_API_KEY=your_mimo_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_VIDEO_MODEL=mimo-v2.5

MINIMAX_API_KEY=your_minimax_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-hd

GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_API_KEY=your_grsai_or_openai_key

MAX_VIDEO_DOWNLOAD_BYTES=52428800
